; Grapeghost — see ../docs/SCALE.md. Every number in [display] and [rendering]
; below is a consequence of that document; change it there first.

config_version=5

[application]

config/name="Grapeghost"
config/description="Social stealth from an orbiting overhead camera. Voxel art at 20 vox/m, 1920x1080."
run/main_scene="res://scenes/lab/scale_lab.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

